# ==============================================================================
# PratimaAR - Konfigurasi Lingkungan (Environment Variables)
# ==============================================================================

# Port & Host Server
PORT=3000
HOST=0.0.0.0

# Mode Lingkungan (development / production)
NODE_ENV=development

# Gemini API Key (keep the real value in your untracked .env file or Vercel settings)
GEMINI_API_KEY=your_gemini_api_key
